# V6 · AETHER 环境变量样例
#
# ⛔ 用法：**不要**直接 `source` 这个文件 —— 它带注释与占位值，
#    需要的变量请在你自己的 shell / 部署环境里显式导出。
#
# ⛔⛔ 这份文件与代码**同源**：`tests/contract_env_docs_test.py` 会静态扫
#     `aether/` 里出现的每一个 `V6_*` 名字，与这里的名字集合**逐个对照**。
#     代码里新增一个变量而忘了写这里（或者反过来）⇒ 契约转红。
#     理由：V6 全部环境变量此前在 README/docs 里 **0 命中** ——
#     `V6_EMB_API_KEY` 这种"配了也没用"的死配置因此没人发现。
#
# 全部变量都是**可选**的：不给就离线跑（默认 stub 路径），
# 这是设计而不是妥协（判据必须离线可回归，见根 README §4）。

# ─── LLM（真模型提议器；不给则用模板提议器）─────────────────────
# OpenAI 兼容端点。例：https://api.example.com/v1
V6_LLM_BASE_URL=
# 模型名。例：qwen3-32b
V6_LLM_MODEL=
# ⛔ 只用于拼请求头，**从不**写进账本 / 日志（有契约守这条）。
V6_LLM_API_KEY=

# ─── 本地 Ollama（另一条真模型路径）─────────────────────────────
# 例：qwen3.5:latest
V6_OLLAMA_MODEL=
# ⛔ 端点（默认 http://127.0.0.1:11434）。存在的理由：写死端口时契约
#    无法注入可控的假端点 ⇒ 「真模型链路跑通了吗」只能靠"本机恰好装了
#    ollama"来证明 ⇒ 没装的机器永远红、装了的永远绿，两种都不是断言。
V6_OLLAMA_BASE_URL=
# 首 token 超时（秒）。本机小模型在长 prompt 下很慢，默认 180s。
V6_OLLAMA_TIMEOUT=

# ─── 嵌入（真嵌入；不给则用 hashing 降级）──────────────────────
# ⛔ 换 embedder 必须走 `aether memory reindex --to ...`（唯一合法路径），
#    否则整库拒载（这是刻意的：混维库会让检索静默变差）。
V6_EMB_MODEL=
V6_EMB_BASE_URL=
# ⛔ 已知缺口：本变量被读入 `self.api_key` 后**没有被任何地方使用**
#    （`embeddings.py` 的 `_post_json` 只发 Content-Type）⇒ 若你的嵌入
#    端点需要鉴权，会静默 401。这里保留是为了不掩盖这个事实。
V6_EMB_API_KEY=
# Ollama 的嵌入模型名。
V6_OLLAMA_EMB_MODEL=

# ─── HTTP API 鉴权 ──────────────────────────────────────────────
# ⛔ 非本机部署**必须**设（`--api-token` 或这个变量），否则拒绝启动。
V6_API_TOKEN=

# ─── 沙箱内部信号（**不要设置它们**）────────────────────────────
# 下面几个由**子进程自己**写出/抛出，用来把"被谁拦下的"回传给父进程；
# 或作为**跨进程可重入守卫**的标记。
# 列在这里写成 `NAME=` 只是为了能被契约逐个对照（注释形式会被解析器漏掉，
# 实测踩过：写成 `# V6_X` 时 A2 判据报"代码里有、文档里没有"）。
# 正常使用**不需要也不应该**设置它们 —— 设了会污染父子进程的判据。
V6_MEMGUARD_KILL=
V6_SANDBOX_DENY=
# ⛔⛔ **`V6_SOURCE_CLEANUP_ACTIVE` 是内部守卫标记，不是配置项**：
#    源码清理 pass 在对拍**起子进程之前**把它置为 `1`，子进程继承后
#    ⇒ 嵌套的 `EvolutionLoop.run()` 不再重复扫源码。
#    没有它 ⇒ run() → 清理 pass → probe → 子进程跑契约 → 契约里 run()
#    → 清理 pass → … **无限递归**（实测失控到 108 个进程且不终止）。
#    ⛔ 它是**跨进程**的：类旗子（进程内存）挡不住子进程，
#       只能靠环境变量（子进程环境由 `dict(os.environ)` 复制 ⇒ 可继承）。
#    ⇒ 手工设它 = 强行关掉清理轴 ⇒ 只在调试时用，别进任何配置文件。
V6_SOURCE_CLEANUP_ACTIVE=
