__pycache__/
*.pyc
data/*.db
# rebuild 的旧库备份（留现场对账，不进版本库）
data/*.db.bak_*
data/*.db-shm
data/*.db-wal
data/*.jsonl
data/*.json
data/archive/
docs/demo_report_*.md
docs/ab_generalization_*.md
#: 取证脚本的**中间产物**（每次跑都生成一份，只留最新那份进库）
docs/probe_frontier_audit_*.json
docs/probe_boundary_*.json
docs/probe_boolop_dimension_*.json
docs/probe_growth_ceiling_*.json
docs/probe_residual_diag_*.json
data/_probe_store.jsonl-shm
data/_probe_store.jsonl-wal
# 沙箱自探测的 seatbelt profile 残留（生成物）
_sandbox.sb
_sandbox.json
node_modules/
.DS_Store

#: REA 桥的全量输出落盘（运行时投影，不是源）
data/rea/
#: REA 兼容层的**编译产物**（由 `scripts/shims/*.c` 现编，缺了现编 ⇒ 不入版本库）
data/rea_shims/

# 备份产物（含唯一事实源副本）：不进版本库，doctor 会检查它存不存在
backups/

#: ⛔ 例外：**种子数据要进版本库**。上面把 data/*.jsonl / *.db / *.json
#:    全排除了（运行产物不该提交），但那样 `git clone` 得到的是
#:    "没有事实源的系统" —— 体检报"账本不存在"、demo 跑不起来。
#:    种子是一份**小而有出处**的最小现场，专门用来被发布。
!data/seed/
!data/seed/data/
!data/seed/data/ledger.jsonl
!data/seed/data/memory.json
data/seed/data/*.lock

#: 能力候选档案（运行产物）：**事实源是账本**（cap.candidate 事件），
#: 这份文件只是"当前待办状态"的便携缓存，可随时由
#: `aether caps candidates propose` 重建 ⇒ 不进版本库。
data/candidates.json

#: 判据集变更时留档的旧账本（`scripts/relaunch_ledger.py` 的产物）：
#: ⛔ **不进版本库**（运行产物），但**也不许删** —— 它是"换尺子之前
#: 的历史"的唯一凭据。留在本地，按需归档。
data/ledger.pre-*.jsonl
data/ledger.v*.jsonl

# 打包产物（`pip wheel .` / `pip install .` 的副产物，r61）
build/
dist/
*.egg-info/

# 打包产物（`pip wheel .` / `pip install .` 的副产物，r61）
build/
dist/
*.egg-info/
