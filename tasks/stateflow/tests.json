{
  "env_id": "stateflow",
  "note": "状态机的可执行判据集：转移、合法性、可达性、路径计数、最短步数。",
  "tests": [
    {"name": "next_state_ok", "call": "next_state",
     "args": ["draft", "submit"], "expect": "review"},
    {"name": "next_state_illegal", "call": "next_state",
     "args": ["draft", "approve"], "expect": null},
    {"name": "next_state_terminal_empty", "call": "legal_actions",
     "args": ["closed"], "expect": []},
    {"name": "legal_actions_sorted", "call": "legal_actions",
     "args": ["review"], "expect": ["approve", "cancel", "reject"]},
    {"name": "run_full_legal", "call": "run_machine",
     "args": ["draft", ["submit", "approve", "ship", "close"]],
     "expect": ["closed", true]},
    {"name": "run_stops_at_illegal", "call": "run_machine",
     "args": ["draft", ["submit", "ship"]], "expect": ["review", false]},
    {"name": "first_illegal_index", "call": "first_illegal",
     "args": ["draft", ["submit", "ship"]], "expect": 1},
    {"name": "first_illegal_none", "call": "first_illegal",
     "args": ["draft", ["submit", "approve"]], "expect": -1},
    {"name": "reachable_true", "call": "reachable",
     "args": ["draft", "shipped", 4], "expect": true},
    {"name": "reachable_false_short", "call": "reachable",
     "args": ["draft", "shipped", 2], "expect": false},
    {"name": "count_paths_draft_to_closed", "call": "count_paths",
     "args": ["draft", "closed", 3], "expect": 4},
    {"name": "count_paths_zero", "call": "count_paths",
     "args": ["closed", "draft", 3], "expect": 0},
    {"name": "depth_to_closed_review", "call": "depth_to_closed",
     "args": ["review", 6], "expect": 1},
    {"name": "depth_to_closed_already", "call": "depth_to_closed",
     "args": ["closed", 6], "expect": 0}
  ]
}
