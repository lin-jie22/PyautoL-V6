{
  "env_id": "scheduler",
  "note": "区间调度的可执行判据集：冲突、最大并发、贪心选择、区间合并、利用率。",
  "tests": [
    {"name": "conflict_true", "call": "has_conflict",
     "args": [[[1, 3], [2, 5], [6, 8]]], "expect": true},
    {"name": "conflict_false_adjacent", "call": "has_conflict",
     "args": [[[1, 2], [2, 3]]], "expect": false},
    {"name": "conflict_empty", "call": "has_conflict", "args": [[]], "expect": false},
    {"name": "max_overlap_two", "call": "max_overlap",
     "args": [[[1, 3], [2, 5], [6, 8]]], "expect": 2},
    {"name": "max_overlap_empty", "call": "max_overlap", "args": [[]], "expect": 0},
    {"name": "min_rooms_equals_overlap", "call": "min_rooms",
     "args": [[[1, 3], [2, 5], [6, 8]]], "expect": 2},
    {"name": "can_schedule_enough", "call": "can_schedule",
     "args": [[[1, 3], [2, 5], [6, 8]], 2], "expect": true},
    {"name": "can_schedule_too_tight", "call": "can_schedule",
     "args": [[[1, 3], [2, 5], [6, 8]], 1], "expect": false},
    {"name": "can_schedule_empty_ok", "call": "can_schedule",
     "args": [[], 0], "expect": true},
    {"name": "merge_overlapping", "call": "merge_intervals",
     "args": [[[1, 3], [2, 5], [6, 8]]], "expect": [[1, 5], [6, 8]]},
    {"name": "merge_adjacent", "call": "merge_intervals",
     "args": [[[1, 2], [2, 3]]], "expect": [[1, 3]]},
    {"name": "merge_empty", "call": "merge_intervals", "args": [[]], "expect": []},
    {"name": "total_busy_no_double_count", "call": "total_busy",
     "args": [[[1, 3], [2, 5], [6, 8]]], "expect": 6},
    {"name": "utilization_half", "call": "utilization",
     "args": [[[1, 3], [2, 5], [6, 8]], 10, 1], "expect": 0.6},
    {"name": "utilization_zero_horizon", "call": "utilization",
     "args": [[[1, 3]], 0, 1], "expect": 0.0},
    {"name": "greedy_picks_two", "call": "greedy_select",
     "args": [[[1, 3], [2, 5], [6, 8]]], "expect": [0, 2]},
    {"name": "greedy_empty", "call": "greedy_select", "args": [[]], "expect": []},
    {"name": "free_slots_three", "call": "free_slots",
     "args": [[[1, 3], [2, 5], [6, 8]], 10, 1], "expect": 3}
  ]
}
